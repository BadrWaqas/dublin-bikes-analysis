# Collected data is regenerated by scripts/collect_data.py and can grow
# large/unbounded over a long collection window, so it isn't committed.
# Keep the folders themselves (via .gitkeep) but ignore their contents.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Env vars / secrets (none required by this project, but just in case)
.env
